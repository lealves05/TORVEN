// TORVEN — site + /api na Cloudflare (a API continua na Supabase Edge Function torven-api).
// Publicar: npx wrangler deploy -c cloudflare/wrangler.jsonc [--domain torven.lorler.com.br]
{
  "$schema": "../frontend/node_modules/wrangler/config-schema.json",
  "name": "torven-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "PRODUCT_ID": "torven",
    "API_UPSTREAM": "https://dwfbxrfniarhufltmlhb.supabase.co/functions/v1/torven-api-cf"
  },
  "observability": { "enabled": true }
}
