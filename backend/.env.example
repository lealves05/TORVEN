# Conexão Postgres (Supabase: use a "Session pooler" connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/torven
# Segredo para assinar os tokens de login (gere um valor longo e aleatório)
JWT_SECRET=troque-este-valor
# Domínios do frontend autorizados (separe por vírgula). Ex.: https://torven.vercel.app,*.vercel.app
CORS_ORIGIN=
PORT=3333
# (opcional) sobrescreve as URLs da Focus NFe — usado só em testes
# FOCUS_URL_HOMOLOGACAO=https://homologacao.focusnfe.com.br
# FOCUS_URL_PRODUCAO=https://api.focusnfe.com.br
